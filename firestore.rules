rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{id} {
      // Eltern & Zuschauer: ein einzelnes Turnier über den Live-Link lesen (ohne Anmeldung)
      allow get: if true;

      // Turnierleitung: Liste sehen, anlegen, ändern, löschen – nur diese E-Mail-Adressen
      // (Adressen in der Liste immer kleinschreiben – Firebase speichert Logins in Kleinbuchstaben)
      allow list, create, update, delete: if request.auth != null
        && request.auth.token.email.lower() in ['deine-mail@example.de'];
    }
  }
}
